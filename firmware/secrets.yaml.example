# firmware/secrets.yaml として複製して実際の値を入れる。
# secrets.yaml は .gitignore 済み。
wifi_ssid: "自宅のSSID（2.4GHz側）"
wifi_password: "パスワード"
fallback_password: "設定用APのパスワード"
ota_password: "OTA 用のパスワード"

# 端末の web_server（保守用の操作画面）の Basic 認証パスワード。ユーザー名は admin。
web_password: ""

# 画像配信 Worker の認証。"Bearer " + Worker に wrangler secret put した ACCESS_TOKEN
authorization_header: "Bearer "

# ESPHome API の暗号鍵。ログを Wi-Fi 経由で読むために使う（Home Assistant は不要）。
# 生成: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: ""

# ファームウェア配信 Worker の認証。
# fw_authorization_header は "Basic " + base64("<fw_user>:<fw_password>")
fw_user: "reterminal"
fw_password: ""
fw_authorization_header: ""
